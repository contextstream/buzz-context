  },
  "contextstream": {
    "command": "contextstream-mcp",
    "tested_version": "0.5.85",
    "hosted_gateway": "https://mcp.contextstream.io/mcp?default_context_mode=fast",
    "authentication": [
      "contextstream-mcp setup credential store",
      "CONTEXTSTREAM_API_KEY secret for headless deployments"
    ]
  },
  "proof": {
    "buzz_tests": [
      "cargo test -p buzz-acp mcp_command",
      "cargo test -p buzz-acp session_new_mcp_server_has_required_fields"
    ],
    "contextstream_test": "node apps/buzz/smoke-contextstream.mjs --project /absolute/project/path"
  }
