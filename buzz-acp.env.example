# The Buzz community this agent should join. Set this explicitly.
BUZZ_RELAY_URL=wss://your-buzz-community.example

# A dedicated Buzz identity for this agent. Keep the real value in a secret
# manager or an uncommitted shell environment.
BUZZ_PRIVATE_KEY=nsec1_replace_me

# Keep the default narrow. Use allowlist only with explicit public keys.
BUZZ_ACP_RESPOND_TO=owner-only
# BUZZ_ACP_RESPOND_TO_ALLOWLIST=64_hex_pubkey,another_64_hex_pubkey

# Safe non-interactive default. Expand permissions only after reviewing the
# selected runtime's own permission model.
BUZZ_ACP_PERMISSION_MODE=dont-ask

# Prefer `contextstream-mcp setup` and its protected credential store. For a
# headless host, inject the key through that platform's secret manager.
# CONTEXTSTREAM_API_KEY=replace_me
